<Window
    x:Class="TagTuner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:TagTuner.Core.Model"
    xmlns:folders="using:TagTuner.Core.Folders"
    xmlns:local="using:TagTuner.App"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="48,*,46">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindShortcut" />
        </Grid.KeyboardAccelerators>

        <!-- ══ Titelleiste ══════════════════════════════════════════
             Pfad und Tabs teilen sich den Platz: Die Tabs nehmen, was sie
             brauchen, der Pfad gibt nach. Die Fenstertasten bleiben nativ. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
              SizeChanged="OnTitleBarResized"
              Padding="10,0,0,0" ColumnSpacing="6">

            <!-- Dasselbe Symbol wie in der Taskleiste, statt einer
                 nachgebauten Wellenform. -->
            <Image Grid.Column="0" Width="24" Height="24"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/TagTuner.png" />

            <!-- Navigation -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1"
                        VerticalAlignment="Center" Margin="4,0,2,0">
                <Button x:Name="BackBtn" Content="&#xE72B;" Click="OnBack"
                        FontFamily="Segoe Fluent Icons" FontSize="12"
                        Width="30" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Back" />
                <Button x:Name="ForwardBtn" Content="&#xE72A;" Click="OnForward"
                        FontFamily="Segoe Fluent Icons" FontSize="12"
                        Width="30" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Forward" />
            </StackPanel>

            <!-- Pfad: nur so breit wie sein Inhalt, linksbuendig. Sobald die
                 Tabs Platz brauchen, deckelt OnTitleBarResized die Breite und
                 der Anfang des Pfades rutscht heraus - der letzte Ordner
                 bleibt sichtbar. -->
            <Grid Grid.Column="2" x:Name="CrumbSlot" SizeChanged="OnCrumbSlotResized">
                <Border x:Name="CrumbBar" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="5" Height="30"
                        Padding="10,0" VerticalAlignment="Center" MinWidth="70">
                    <ScrollViewer x:Name="CrumbScroll"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CrumbHost" Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Tabs -->
            <!-- Fortschritt: direkt rechts vom Pfad, nur sichtbar während
                 gearbeitet wird. -->
            <Grid Grid.Column="3" x:Name="ProgressHost" Visibility="Collapsed"
                  VerticalAlignment="Center" Margin="6,0,6,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="150" Height="5" CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                        <ProgressBar x:Name="Progress" Height="5" CornerRadius="3"
                                     Background="Transparent"
                                     Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="ProgressLabel" FontSize="11" FontFamily="Consolas"
                               MinWidth="30" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="3" />
                <Button x:Name="AddTabBtn" Content="&#xE710;" Click="OnAddTab"
                        FontFamily="Segoe Fluent Icons" FontSize="12"
                        Width="28" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Open folder in a new tab" />
            </StackPanel>

            <!-- Werkzeuge -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" Margin="4,0,0,0">
                <Button x:Name="SplitBtn" Content="&#xE745;" Click="OnToggleSplit"
                        FontFamily="Segoe Fluent Icons" FontSize="13"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Split the view" />
                <Button x:Name="HistoryBtn" Content="&#xE81C;" Click="OnOpenHistory"
                        FontFamily="Segoe Fluent Icons" FontSize="14"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="History and undo" />
                <Button x:Name="SettingsBtn" Content="&#xE713;" Click="OnOpenSettings"
                        FontFamily="Segoe Fluent Icons" FontSize="14"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Settings" />
            </StackPanel>

            <!-- Platzhalter fuer die Fenstertasten des Systems: sie werden
                 ueber die Titelleiste gezeichnet, nicht in sie hinein. -->
            <Border Grid.Column="6" x:Name="CaptionSpacer" Width="0" />
        </Grid>

        <!-- ══ Arbeitsfläche ════════════════════════════════════════ -->
        <Grid Grid.Row="1" x:Name="Work">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MetaCol" Width="300" MinWidth="230" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="TreeCol" Width="214" MinWidth="150" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="SideCol" Width="248" MinWidth="190" />
            </Grid.ColumnDefinitions>

            <!-- ── Metadaten ─────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" x:Name="MetaHead" Text="METADATA"
                           Margin="14,10,14,6" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <ScrollViewer Grid.Row="1" Padding="14,0,14,12">
                    <StackPanel Spacing="10">

                        <!-- Cover -->
                        <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    RightTapped="OnCoverRightTapped"
                                    ToolTipService.ToolTip="Right click: set or remove cover">
                                <Image x:Name="CoverImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Top">
                                <TextBlock x:Name="CoverMime" FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CoverInfo" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Title" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FTitle" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Artist" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FArtist" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Album" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FAlbum" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,0.8*,0.8*,1.3*" ColumnSpacing="7">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Year" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FYear" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Track" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FTrack" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Disc" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FDisc" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Genre" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FGenre" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Album artist" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FAlbumArtist" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Composer" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FComposer" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Comment" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FComment" />
                        </StackPanel>
                        <!-- Audio: technisch, kein Tag — darum abgesetzt -->
                        <Border CornerRadius="5" Padding="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="AUDIO" FontSize="11" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border CornerRadius="9" Padding="6,0"
                                            Background="{StaticResource WarnDimBrush}">
                                        <TextBlock Text="re-encodes" FontSize="10"
                                                   Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="File format" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FFormat" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Sample rate" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FRate" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="TechPanel" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Anwenden-Fuß: sagt vorher, was passiert -->
                <Border Grid.Row="2" Padding="14,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PlanText" FontSize="11.5" TextWrapping="Wrap"
                                   MinHeight="17"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" x:Name="ResetBtn" Content="Reset"
                                    HorizontalAlignment="Stretch" Click="OnReset" />
                            <Button Grid.Column="1" x:Name="ApplyBtn" Content="Apply"
                                    HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnApply" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <local:GripArea Grid.Column="1" Tag="meta" Background="Transparent"
                  Margin="-3,0,-3,0"
                  PointerPressed="OnPanelGripPressed" PointerMoved="OnPanelGripMoved"
                  PointerReleased="OnPanelGripReleased" PointerExited="OnPanelGripExited">
                <Rectangle Width="1" HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:GripArea>

            <!-- ── Baum ──────────────────────────────────────────── -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,8,6,4">
                    <TextBlock Grid.Column="0" Text="LIBRARY" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="1" x:Name="AddRootBtn" Content="&#xE710;"
                            FontFamily="Segoe Fluent Icons" FontSize="11"
                            Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Click="OnLibraryMenu"
                            ToolTipService.ToolTip="Manage library" />
                </Grid>

                <TextBox Grid.Row="1" x:Name="SearchBox" Margin="10,0,10,6"
                         PlaceholderText="Search folders and songs…"
                         TextChanged="OnSearchChanged" />
                <muxc:TreeView Grid.Row="2" x:Name="FolderTree"
                               SelectionMode="Single"
                               Expanding="OnTreeExpanding"
                               Collapsed="OnTreeCollapsed"
                               ItemInvoked="OnTreeItemInvoked"
                               Margin="0,0,2,8">

                    <!-- Der Aufklapp-Pfeil bekommt weniger Platz, die Zeile
                         mehr: kleinerer Glyph, kaum Polsterung ringsum, dafuer
                         eine hohe Zeile fuer ein grosses Cover. -->
                    <muxc:TreeView.ItemContainerStyle>
                        <Style TargetType="muxc:TreeViewItem">
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="Padding" Value="0,0,4,0" />
                            <Setter Property="GlyphSize" Value="10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </muxc:TreeView.ItemContainerStyle>

                    <!-- Im unbound-Betrieb ist der Datenkontext einer Zeile der
                         TreeViewNode; unser Ordner haengt an dessen Content.
                         Darum {Binding} statt {x:Bind}: der Content ist object.

                         Das Ordnersymbol liegt hinter dem Bild. Hat der Ordner
                         kein Cover, bleibt die Image-Quelle leer und das Symbol
                         scheint durch - das spart einen Konverter. -->
                    <muxc:TreeView.ItemTemplate>
                        <DataTemplate>
                            <!-- Der Aufklapp-Pfeil hat im WinUI-Template ein fest
                                 verdrahtetes Padding von 14 Pixeln je Seite. Der
                                 aeussere Rand ist ueber TreeViewItemPresenterMargin
                                 weg; die restlichen 14 rechts holt dieser negative
                                 Rand halb zurueck, damit der Pfeil mittig zwischen
                                 Spaltenrand und Cover sitzt. -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Height="50"
                                        Margin="-6,0,0,0"
                                        Background="Transparent"
                                        Tag="RowContent"
                                        RightTapped="OnTreeRightTapped">
                                <Border Width="42" Height="42" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Image Source="{Binding Content.Cover}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{Binding Content.Name}"
                                               FontSize="13.5" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Content.Artist}"
                                               Visibility="{Binding Content.HasArtist}"
                                               FontSize="11" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:TreeView.ItemTemplate>
                </muxc:TreeView>

                <!-- Treffer legen sich ueber den Baum, statt ihn zu ersetzen:
                     Beim Leeren des Suchfelds steht der Baum noch genauso da,
                     wie man ihn aufgeklappt hatte. -->
                <Grid Grid.Row="2" x:Name="SearchPanel" Visibility="Collapsed"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                      RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" x:Name="SearchInfo" Margin="14,4,14,6"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ListView Grid.Row="1" x:Name="SearchList" Margin="4,0,4,8"
                              SelectionMode="Single"
                              RightTapped="OnSearchHitRightTapped"
                              ItemClick="OnSearchHitClicked" IsItemClickEnabled="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,2" />
                                <Setter Property="MinHeight" Value="44" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="folders:SearchHit">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Height="44">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon FontSize="13"
                                                      Glyph="{x:Bind Glyph}"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                            <!-- Liegt ein Cover vor, deckt es
                                                 das Symbol zu. -->
                                            <Image local:TrackArt.Path="{x:Bind Path}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Context}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <local:GripArea Grid.Column="3" Tag="tree" Background="Transparent"
                  Margin="-3,0,-3,0"
                  PointerPressed="OnPanelGripPressed" PointerMoved="OnPanelGripMoved"
                  PointerReleased="OnPanelGripReleased" PointerExited="OnPanelGripExited">
                <Rectangle Width="1" HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:GripArea>

            <!-- ── Trackliste, optional geteilt ──────────────────── -->
            <Grid Grid.Column="4" x:Name="PaneHost" RowDefinitions="*,Auto,Auto">
                <local:TrackPane Grid.Row="0" x:Name="PaneA" />

                <!-- Suchleiste, oben rechts ueber der Liste: sie liegt
                     darueber statt daneben, damit sie beim Oeffnen nichts
                     verschiebt. -->
                <Border Grid.Row="0" x:Name="FindBar" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,46,22,0" Padding="7,5" CornerRadius="6"
                        BorderThickness="1"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center">
                        <TextBox x:Name="FindBox" Width="188" FontSize="12.5"
                                 PlaceholderText="Find in this folder…"
                                 TextChanged="OnFindChanged"
                                 KeyDown="OnFindKeyDown" />
                        <TextBlock x:Name="FindCount" FontSize="11.5" MinWidth="46"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Button x:Name="FindPrev" Content="&#xE74A;" Click="OnFindPrevious"
                                FontFamily="Segoe Fluent Icons" FontSize="11"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Previous match" />
                        <Button x:Name="FindNext" Content="&#xE74B;" Click="OnFindNext"
                                FontFamily="Segoe Fluent Icons" FontSize="11"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Next match" />
                        <Button Content="&#xE711;" Click="OnFindClose"
                                FontFamily="Segoe Fluent Icons" FontSize="11"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Close" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" x:Name="Splitter" Height="5" Visibility="Collapsed"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderThickness="0,1,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TrackPane Grid.Row="2" x:Name="PaneB" Visibility="Collapsed" />
            </Grid>

            <local:GripArea Grid.Column="5" Tag="side" Background="Transparent"
                  Margin="-3,0,-3,0"
                  PointerPressed="OnPanelGripPressed" PointerMoved="OnPanelGripMoved"
                  PointerReleased="OnPanelGripReleased" PointerExited="OnPanelGripExited">
                <Rectangle Width="1" HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:GripArea>

            <!-- ── Ordner-Analyse ────────────────────────────────── -->
            <Grid Grid.Column="6" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="FOLDER ANALYSIS" Margin="14,10,14,6"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ScrollViewer Grid.Row="1" Padding="14,0,14,14">
                    <StackPanel Spacing="12">
                        <Border x:Name="VerdictBox" CornerRadius="5" Padding="11,10">
                            <TextBlock x:Name="VerdictText" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="AnalysisPanel" Spacing="7" />
                        <StackPanel Spacing="6">
                            <Button x:Name="AlignBtn" Content="Align folder"
                                    HorizontalAlignment="Stretch" Click="OnAlign" />
                            <Button x:Name="RenameBtn" Content="Rename…"
                                    HorizontalAlignment="Stretch" Click="OnRenameFiles" />
                            <Button x:Name="CoverAllBtn" Content="Set cover for all…"
                                    HorizontalAlignment="Stretch" Click="OnCoverForAll" />
                        </StackPanel>

                        <!-- Was die App in diesem Ordner von sich aus tun darf.
                             Wird je Ordner gemerkt. -->
                        <Border CornerRadius="5" Padding="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="9">
                                <TextBlock Text="ALBUM MODE" FontSize="11" FontWeight="Bold"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ToggleSwitch x:Name="AlbumSwitch"
                                              Header="This folder is one release"
                                              OnContent="on" OffContent="off"
                                              Toggled="OnFolderRuleChanged" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="For an album, an EP or a single: one release with uniform metadata. It overwrites to make the folder consistent, so leave it off for folders where you collect mixed music." />

                                <!-- Was der Modus angleicht. Ohne ihn bewirken
                                     die Haken nichts, darum sind sie dann aus. -->
                                <StackPanel Spacing="2" Margin="2,0,0,0">
                                    <CheckBox x:Name="BaseTagsBox" Content="Base metadata"
                                              MinHeight="28" Click="OnFolderRuleChanged" />
                                    <CheckBox x:Name="CoverBox" Content="Cover"
                                              MinHeight="28" Click="OnFolderRuleChanged" />
                                    <CheckBox x:Name="NumberingBox" Content="Track numbering"
                                              MinHeight="28" Click="OnFolderRuleChanged" />
                                </StackPanel>

                                <TextBlock x:Name="AlbumNote" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <TextBlock Text="ON DROP" FontSize="11" FontWeight="Bold"
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ToggleSwitch x:Name="ConformSwitch"
                                              Header="Align format and sample rate"
                                              OnContent="on" OffContent="off"
                                              Toggled="OnFolderRuleChanged" />
                                <TextBlock x:Name="RuleNote" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <HyperlinkButton x:Name="ResetRuleBtn" FontSize="11.5"
                                                 Padding="0" Visibility="Collapsed"
                                                 Content="Reset to the global setting"
                                                 Click="OnResetFolderRule" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SideNote" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ══ Statusleiste ═════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Padding="10,0,12,0"
              ColumnSpacing="12"
              BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">

            <!-- Wiedergabe: ein Knopf fuer Start und Pause, daneben die
                 Lautstaerke, die erst herausfaehrt wenn etwas laeuft. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="PlayBtn" Content="&#xE768;" Click="OnTogglePlay"
                        FontFamily="Segoe Fluent Icons" FontSize="13"
                        Width="32" Height="32" Padding="0" CornerRadius="16"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Play and pause, or press space in the list" />

                <Border x:Name="VolumeHost" Width="0" Opacity="0"
                        VerticalAlignment="Center" SizeChanged="OnVolumeHostResized">
                    <StackPanel Orientation="Horizontal" Spacing="5" Width="104"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE767;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Slider x:Name="VolumeSlider" Width="82" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                ValueChanged="OnVolumeChanged" />
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="0" MaxWidth="210">
                    <TextBlock x:Name="NowPlaying" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowTime" FontSize="10.5" FontFamily="Consolas"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Nur zu sehen, wenn ffmpeg fehlt. Dass alles in Ordnung ist,
                 muss nicht dauerhaft dastehen. -->
            <TextBlock Grid.Column="2" x:Name="FfmpegText" VerticalAlignment="Center"
                       FontSize="11.5" Visibility="Collapsed"
                       Foreground="{StaticResource WarnBrush}" />

            <!-- Letzte Spalte, rechtsbündig: so sitzt der Text wirklich in der
                 Ecke statt mit den Abständen leerer Spalten davor. -->
            <TextBlock Grid.Column="3" x:Name="StatusText" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       MaxWidth="620"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
