<UserControl
    x:Class="TagTuner.App.TrackPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagTuner.App"
    xmlns:model="using:TagTuner.Core.Model">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Kopfzeile der Hälfte: welcher Ordner, wie viele Tracks. Ein Klick
             darauf macht die Hälfte zur aktiven, in der geteilten Ansicht der
             schnelle Weg, zwischen den Ordnern zu wechseln. -->
        <Grid Grid.Row="0" x:Name="PaneBar" ColumnDefinitions="Auto,Auto,*,Auto" Padding="18,9"
              ColumnSpacing="8" Background="Transparent" Tapped="OnPaneBarTapped"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock Grid.Column="0" x:Name="FolderName" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       PointerEntered="OnFolderNameEnter" PointerExited="OnFolderNameExit" />
            <!-- Anklickbar: Es ist der Weg zurueck in den einzelnen Ordner.
                 Ein eigener Knopf in der Seitenspalte stand dafuer im Weg,
                 obwohl man ihn fast nie braucht. -->
            <Border Grid.Column="1" x:Name="ScopeBadge" CornerRadius="9" Padding="7,1"
                    VerticalAlignment="Center" Visibility="Collapsed"
                    Background="{StaticResource WarnDimBrush}"
                    Tapped="OnScopeBadgeTapped"
                    ToolTipService.ToolTip="Show this folder only">
                <TextBlock Text="with subfolders" FontSize="10"
                           Foreground="{StaticResource WarnBrush}" />
            </Border>
            <TextBlock Grid.Column="2" x:Name="CountLabel" FontSize="11.5"
                       FontFamily="{StaticResource DataFont}"
                       VerticalAlignment="Bottom" Margin="0,0,0,2"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <HyperlinkButton Grid.Column="3" Content="Select all" FontSize="11.5"
                             Padding="6,2" Click="OnSelectAll" />
        </Grid>

        <!-- Kopfzeile und Liste scrollen gemeinsam waagerecht, wenn die
             Spalten nicht ins Fenster passen. Senkrecht bleibt der
             ScrollViewer aus: Das Scrollen übernimmt die Liste selbst, und
             nur so behält sie eine feste Höhe und virtualisiert weiter. -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" x:Name="WideScroll"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      SizeChanged="OnWideScrollResized">
        <Grid x:Name="Wide" RowDefinitions="Auto,*" HorizontalAlignment="Left">

        <!-- Kopfzeile: Inhalt und Breiten entstehen zur Laufzeit, weil
             Auswahl und Reihenfolge der Spalten dem Nutzer gehören.
             Siehe TrackColumns.BuildHeader. Der durchsichtige Hintergrund
             lässt Zeigerbewegungen auch zwischen den Überschriften ankommen,
             sonst bräche das Ziehen einer Spalte an jeder Lücke ab. -->
        <Grid Grid.Row="0" x:Name="HeaderRow" Padding="4,4,20,6" ColumnSpacing="10"
              Background="Transparent"
              PointerMoved="OnHeaderMoved"
              PointerReleased="OnHeaderReleased"
              PointerCaptureLost="OnHeaderReleased"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="1">
            <!-- Umsortieren und Hinausziehen macht die Liste nicht selbst,
                 sondern TrackPane.Reorder.cs: Die Zeilen sollen beim Ziehen
                 gleiten wie auf der Website. -->
            <ListView x:Name="List"
                      SelectionMode="Extended"
                      SelectionChanged="OnSelectionChanged"
                      CanReorderItems="False"
                      CanDragItems="False"
                      AllowDrop="True"
                      DragOver="OnDragOver"
                      Drop="OnDrop"
                      DragLeave="OnDragLeave"
                      RightTapped="OnRightTapped"
                      KeyDown="OnListKeyDown"
                      DoubleTapped="OnListDoubleTapped"
                      GotFocus="OnGotFocus"
                      ContainerContentChanging="OnRowRealizing"
                      Padding="0,4,6,14">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,0,12,0" />
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- Bewusst leer: Welche Spalten eine Zeile hat, steht erst
                     zur Laufzeit fest. TrackColumns.BuildRow füllt dieses
                     Grid, sobald die Liste eine Zeile zeichnet. -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:AudioTrack">
                        <Grid />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Einfügemarke: zeigt beim Ziehen aus einem anderen Ordner,
                 an welcher Track-Position die Dateien landen. -->
            <Rectangle x:Name="DropLine" Height="2" Margin="16,0,16,0"
                       VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       RadiusX="1" RadiusY="1" IsHitTestVisible="False"
                       Visibility="Collapsed"
                       Fill="{StaticResource AccentBrush}" />
        </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
