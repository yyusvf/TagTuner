<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TagTuner.App</RootNamespace>
    <AssemblyName>TagTuner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TagTuner.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: schreibt HKCU für das Kontextmenü, läuft als einzelne
         Exe und aktualisiert sich selbst. Mit MSIX bräuchte all das ein
         Zertifikat. -->
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Product>TagTuner</Product>
    <Company>yyusvf</Company>
    <Version>0.6.0</Version>
    <Description>Lokale Audiovorbereitung — Samplerate, Format und Metadaten</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TagTuner.Core\TagTuner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ffmpeg.exe neben die Anwendung legen, sofern sie geholt wurde.
       Sie liegt nicht im Repo (rund 80 MB) — tools\fetch-ffmpeg.ps1 holt sie. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\ffmpeg.exe')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\ffmpeg.exe"
             Link="ffmpeg.exe"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    „dotnet publish" lässt das kompilierte XAML (*.xbf) und den Ressourcen-
    index (TagTuner.pri) im Build-Ordner liegen. Ohne sie findet
    InitializeComponent() zur Laufzeit nichts und die Anwendung stirbt
    beim Start mit 0xC000027B in Microsoft.UI.Xaml.dll — ohne jede
    verwertbare Meldung. Der Build-Ordner enthält sie, der Publish-Ordner
    nicht; darum hier von Hand nachreichen.
  -->
  <Target Name="IncludeXamlArtifactsInPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="Build">
    <ItemGroup>
      <_XamlArtifact Include="$(OutputPath)**\*.xbf" />
      <_XamlArtifact Include="$(OutputPath)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_XamlArtifact)"
                             RelativePath="%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
