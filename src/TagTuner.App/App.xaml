<Application
    x:Class="TagTuner.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TagTuner.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- TagTuners eigener Akzent, aus dem Logo übernommen -->
            <SolidColorBrush x:Key="AccentBrush" Color="#C8F542" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="#26C8F542" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F5C451" />
            <SolidColorBrush x:Key="WarnDimBrush" Color="#22F5C451" />

            <!-- „Passt" ist dieselbe Limette wie der Akzent. Vorher stand hier
                 ein zweites, anderes Grün, und zwei Grüns nebeneinander sehen
                 wie ein Versehen aus. -->
            <SolidColorBrush x:Key="OkBrush" Color="#C8F542" />
            <SolidColorBrush x:Key="OkDimBrush" Color="#1FC8F542" />

            <!-- Der Systemakzent wird die Limette aus dem Logo. Sonst nähmen
                 Schalter, Haken, Auswahl und Hauptknöpfe die Farbe, die in
                 Windows eingestellt ist, und die App hätte zwei Akzente.
                 Im dunklen Thema füllen die hellen Stufen (Text darauf
                 schwarz), im hellen die dunklen (Text darauf weiß): Auf
                 Weiß wäre die Limette selbst kaum zu lesen. -->
            <Color x:Key="SystemAccentColor">#C8F542</Color>
            <Color x:Key="SystemAccentColorLight1">#D2F760</Color>
            <Color x:Key="SystemAccentColorLight2">#C8F542</Color>
            <Color x:Key="SystemAccentColorLight3">#E2FB9C</Color>
            <Color x:Key="SystemAccentColorDark1">#5C7A00</Color>
            <Color x:Key="SystemAccentColorDark2">#4A6300</Color>
            <Color x:Key="SystemAccentColorDark3">#394C00</Color>

            <!-- Schriften. Bahnschrift, die DIN-Schrift aus Windows, für alles,
                 was beschriftet: Überschriften, Spaltenköpfe, Abschnitte, wie
                 die Gravur auf einem Mischpult. Cascadia Mono für Werte, die
                 man vergleicht: Format, Samplerate, Dauer, Nummern. Beide
                 kommen mit Windows; fehlt Cascadia, springt Consolas ein. -->
            <FontFamily x:Key="LabelFont">Bahnschrift</FontFamily>
            <FontFamily x:Key="DataFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Beschriftung über einem Eingabefeld: dieselbe Schrift wie die
                 Abschnitte, aber normal gesetzt, damit sie leiser bleibt. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Kleine Abschnittsüberschrift: schmal, halbfett, gesperrt. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!-- Der Rand um den Aufklapp-Pfeil. WinUI setzt hier 4 Pixel links,
                 dazu kommen 14 fest verdrahtete im Chevron selbst — der Pfeil
                 sass dadurch viel zu weit rechts in seiner Flaeche. Die
                 Einrichtung je Baumebene haengt an einem inneren Element und
                 bleibt davon unberuehrt. -->
            <Thickness x:Key="TreeViewItemPresenterMargin">0,2</Thickness>

            <!-- Eine Instanz fuer alle Listen: Kopfzeile und Zeilenvorlage
                 binden beide hierauf, damit die Spalten deckungsgleich sind. -->
            <local:TrackColumnLayout x:Key="TrackColumns" />

            <!-- Greifer zwischen zwei Spalten: unsichtbar, aber anfassbar.
                 Transparent statt gar kein Hintergrund, sonst faellt der
                 Zeiger durch und die Flaeche nimmt keine Klicks an. -->
            <Style x:Key="ColumnGrip" TargetType="Border">
                <Setter Property="Width" Value="9" />
                <Setter Property="Margin" Value="0,-6,-8,-6" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="ColHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
