<ContentDialog
    x:Class="TagTuner.App.CoverCropDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Coverausschnitt wählen"
    PrimaryButtonText="Übernehmen"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Width="380">
        <TextBlock FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Das Bild ist nicht quadratisch. Zieh den Rahmen an die Stelle, die als Cover gespeichert werden soll." />

        <!-- Die Bühne ist immer 360×360 groß; das Bild liegt darin zentriert
             und der Rahmen bewegt sich nur über dem Bild, nie daneben. -->
        <Border HorizontalAlignment="Center" CornerRadius="5"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid x:Name="Stage" Width="360" Height="360"
                  Background="Transparent"
                  PointerPressed="OnStagePressed"
                  PointerMoved="OnStageMoved"
                  PointerReleased="OnStageReleased">
                <Image x:Name="Preview" Stretch="Uniform" />

                <!-- Vier Schleier rings um die Auswahl statt einer Maske:
                     WinUI kann kein Loch in ein Rechteck stanzen. -->
                <Rectangle x:Name="ShadeTop" Fill="#A6000000" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle x:Name="ShadeBottom" Fill="#A6000000" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle x:Name="ShadeLeft" Fill="#A6000000" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle x:Name="ShadeRight" Fill="#A6000000" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Rectangle x:Name="Frame" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           StrokeThickness="2" RadiusX="2" RadiusY="2"
                           Stroke="{StaticResource AccentBrush}" />
            </Grid>
        </Border>

        <StackPanel Spacing="3">
            <TextBlock x:Name="SizeLabel" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="SizeSlider" Minimum="10" Maximum="100" Value="100"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="OnSizeChanged" />
        </StackPanel>

        <TextBlock x:Name="ResultLabel" FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</ContentDialog>
