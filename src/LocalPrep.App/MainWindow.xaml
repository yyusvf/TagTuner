<Window
    x:Class="LocalPrep.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:LocalPrep.Core.Model"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="48,*,34">

        <!-- ══ Titelleiste ══════════════════════════════════════════
             Eigene Leiste: Pfad und Tabs teilen sich den Platz, die
             Fenstertasten bleiben nativ (ExtendsContentIntoTitleBar). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*,Auto"
              Padding="12,0,0,0" ColumnSpacing="8">

            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="LocalPrep" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,6,0" />

            <!-- Pfad: schrumpft zuerst, der letzte Ordner bleibt lesbar -->
            <Border Grid.Column="2" x:Name="CrumbBar"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Height="30"
                    Padding="10,0" VerticalAlignment="Center" MinWidth="60">
                <TextBlock x:Name="CrumbText" VerticalAlignment="Center"
                           FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="HistoryBtn" Content="&#xE7A7;" Click="OnOpenHistory"
                        FontFamily="Segoe Fluent Icons" FontSize="14"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Verlauf und Rückgängig" />
                <Button x:Name="RefreshBtn" Content="&#xE72C;" Click="OnRefresh"
                        FontFamily="Segoe Fluent Icons" FontSize="14"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Neu einlesen" />
                <Button x:Name="SettingsBtn" Content="&#xE713;" Click="OnOpenSettings"
                        FontFamily="Segoe Fluent Icons" FontSize="14"
                        Width="32" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Einstellungen" />
            </StackPanel>
        </Grid>

        <!-- ══ Arbeitsfläche ════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="300,1,214,1,*,1,248">

            <!-- ── Metadaten ─────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" x:Name="MetaHead" Text="METADATEN"
                           Margin="14,10,14,6" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <ScrollViewer Grid.Row="1" Padding="14,0,14,12">
                    <StackPanel Spacing="10">

                        <!-- Cover -->
                        <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Image x:Name="CoverImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Top">
                                <TextBlock x:Name="CoverMime" FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="CoverInfo" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Titel" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FTitle" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Interpret" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FArtist" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Album" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FAlbum" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,0.8*,0.8*,1.3*" ColumnSpacing="7">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Jahr" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FYear" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Track" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FTrack" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Disc" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FDisc" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Genre" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FGenre" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Album-Interpret" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FAlbumArtist" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Komponist" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FComposer" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Kommentar" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FComment" AcceptsReturn="True" Height="40"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Audio: technisch, kein Tag — darum abgesetzt -->
                        <Border CornerRadius="5" Padding="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="AUDIO" FontSize="11" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border CornerRadius="9" Padding="6,0"
                                            Background="{StaticResource WarnDimBrush}">
                                        <TextBlock Text="kodiert neu" FontSize="10"
                                                   Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Dateiformat" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FFormat" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Samplerate" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FRate" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="Bitrate bleibt unangetastet — sie fällt nur an, wenn ohnehin verlustbehaftet kodiert wird." />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="TechPanel" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Anwenden-Fuß: sagt vorher, was passiert -->
                <Border Grid.Row="2" Padding="14,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PlanText" FontSize="11.5" TextWrapping="Wrap"
                                   MinHeight="17"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" x:Name="ResetBtn" Content="Zurücksetzen"
                                    HorizontalAlignment="Stretch" Click="OnReset" />
                            <Button Grid.Column="1" x:Name="ApplyBtn" Content="Anwenden"
                                    HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnApply" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ── Baum ──────────────────────────────────────────── -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="BIBLIOTHEK" Margin="14,10,14,6"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <muxc:TreeView Grid.Row="1" x:Name="FolderTree"
                               SelectionMode="Single"
                               Expanding="OnTreeExpanding"
                               ItemInvoked="OnTreeItemInvoked"
                               Margin="4,0,4,8" />
            </Grid>

            <Rectangle Grid.Column="3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ── Trackliste ────────────────────────────────────── -->
            <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="14,8"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <TextBlock x:Name="FolderName" FontWeight="SemiBold" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton Grid.Column="1" Content="Alle wählen" FontSize="11.5"
                                     Padding="6,2" Click="OnSelectAll" />
                </Grid>

                <!-- Kopfzeile: Spaltenbreiten müssen zur Zeilenvorlage passen -->
                <Grid Grid.Row="1" Padding="18,6,18,6"
                      ColumnDefinitions="34,1.3*,0.85*,0.85*,62,78,52"
                      ColumnSpacing="8"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <TextBlock Grid.Column="0" Text="#" HorizontalAlignment="Right" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="1" Text="TITEL" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="2" Text="INTERPRET" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="3" Text="ALBUM" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="4" Text="FORMAT" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="5" Text="SAMPLERATE" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="6" Text="DAUER" Style="{StaticResource ColHeader}" />
                </Grid>

                <ListView Grid.Row="2" x:Name="TrackList"
                          SelectionMode="Extended"
                          SelectionChanged="OnTrackSelectionChanged"
                          CanReorderItems="True"
                          AllowDrop="True"
                          CanDragItems="True"
                          DragOver="OnListDragOver"
                          Drop="OnListDrop"
                          DragItemsCompleted="OnReorderCompleted"
                          Padding="4,4,4,12">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="MinHeight" Value="34" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:AudioTrack">
                            <Grid ColumnDefinitions="34,1.3*,0.85*,0.85*,62,78,52"
                                  ColumnSpacing="8" Height="34">
                                <TextBlock Grid.Column="0" Text="{x:Bind Track}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                           VerticalAlignment="Center" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Artist}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Album}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Format}"
                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind SampleRateLabel}"
                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind DurationLabel}"
                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Rectangle Grid.Column="5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ── Ordner-Analyse ────────────────────────────────── -->
            <Grid Grid.Column="6" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="ORDNER-ANALYSE" Margin="14,10,14,6"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ScrollViewer Grid.Row="1" Padding="14,0,14,14">
                    <StackPanel Spacing="12">
                        <Border x:Name="VerdictBox" CornerRadius="5" Padding="11,10">
                            <TextBlock x:Name="VerdictText" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="AnalysisPanel" Spacing="7" />
                        <StackPanel Spacing="6">
                            <Button x:Name="AlignBtn" Content="Ordner angleichen"
                                    HorizontalAlignment="Stretch" Click="OnAlign" />
                            <Button x:Name="RenameBtn" Content="Umbenennen…"
                                    HorizontalAlignment="Stretch" IsEnabled="False" />
                            <Button x:Name="CoverAllBtn" Content="Cover für alle setzen…"
                                    HorizontalAlignment="Stretch" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="SideNote" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ══ Statusleiste ═════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Padding="14,0" ColumnSpacing="14"
              BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar Grid.Column="1" x:Name="Progress" Width="130" Height="3"
                         VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock Grid.Column="2" x:Name="CountText" VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" x:Name="FfmpegText" VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
